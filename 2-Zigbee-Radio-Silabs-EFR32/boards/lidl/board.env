# board.env — Lidl Silvercrest Gateway (reference board)
#
# Sourced by the EFR32 firmware build scripts (build_ncp.sh, build_ot_rcp.sh)
# when BOARD=lidl, the default. Packages the board-specific facts the firmware
# build needs: the exact MCU ordering part number and the UART routing to the
# RTL8196E. See ../README.md for the porting contract.
#
# These values reproduce the historical hard-coded build exactly, so a default
# (BOARD=lidl) build is byte-for-byte unchanged.

BOARD_NAME="Lidl Silvercrest Gateway"

# Exact MCU OPN handed to `slc generate --with`.
BOARD_TARGET_DEVICE="EFR32MG1B232F256GM48"

# UART link to the RTL8196E host (host UART1 <-> this USART).
# Ports are GPIO port letters; each pin entry is "<port> <pin> <location>".
BOARD_UART_PERIPHERAL="USART0"
BOARD_UART_PERIPHERAL_NO="0"
BOARD_UART_TX="A 0 0"      # PA0, loc 0
BOARD_UART_RX="A 1 0"      # PA1, loc 0
BOARD_UART_FLOW="hw"       # hw = RTS/CTS handshake | none = no hardware flow
BOARD_UART_CTS="A 5 30"    # PA5, loc 30
BOARD_UART_RTS="A 4 30"    # PA4, loc 30

# Bootloader revision — the low 16 bits of the Gecko bootloader version word
# (major<<24 | minor<<16 | customer). "2.4" is Silicon Labs' own version; this
# third number is the customer field, which the SDK leaves to the integrator.
#
# It is not decoration. The bootloader installs a stage-2 upgrade over UART only
# when the incoming image is STRICTLY newer than the running one, and declines in
# silence otherwise — after having erased the application, because the image is
# staged inside application space (#148). So this number must be bumped whenever
# THIS BOARD's bootloader binary changes, or the new image can never reach a unit
# already running the old one.
#
# Lidl stays at 2: its bootloader binary has not changed. The GPIO-activation
# work of #148 touched only the Sengled build, and a bump here would break the
# byte-for-byte reproducibility of the shipped image for nothing.
BOARD_BTL_CUSTOMER="2"
