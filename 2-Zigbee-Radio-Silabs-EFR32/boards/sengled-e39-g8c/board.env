# board.env — Sengled Smart Hub G4 (E39-G8C), contributed by @hlyi
#
# STATUS: VALIDATED (#130). The NCP firmware built from this file was flashed to
# a real G4 and confirmed working end-to-end — Home Assistant talks to the radio
# (@hlyi, 2026-06-13). Every value below is a verified G4 hardware fact:
#
#   - BOARD_TARGET_DEVICE: MG13P ordering part number from the #133 hardware page.
#   - BOARD_UART_FLOW=sw: the G4 has no RTS/CTS wiring (#123), so it builds with
#     software XON/XOFF flow control (paired with the bridge's flow_control=sw).
#     This is a first-class SDK option, applied by the build — not a patch.
#   - BOARD_UART_PERIPHERAL / TX / RX: the G4 wires the EFR32 UART on the SAME
#     USART and pins as the Lidl reference (USART0, PA0 = TX, PA1 = RX), confirmed
#     on hardware by @hlyi in #130 ("G4 Radio IC also uses the same pin as Lidl").
#
# CTS/RTS entries are ignored when flow=sw, kept only so the file is uniform.
#
# Scope: NCP is validated and a prebuilt G4 NCP .gbl is committed. OT-RCP,
# the Z3 Router, the Gecko bootloader and RCP (#143) build for the G4 (MG13)
# but have not been functionally tested on G4 yet — build them yourself and
# validate over SWD before trusting them (the bootloader especially: a bad
# bootloader flash is an SWD-only recovery). RCP: CPC has no software flow
# control, so flow=sw is built as none and recorded as none in radio.conf
# (the bridge — cpcd's TCP peer — is the chip's flow partner and must match).

BOARD_NAME="Sengled Smart Hub G4 (E39-G8C)"

# Exact MCU OPN handed to `slc generate --with` — verified from PR #133.
BOARD_TARGET_DEVICE="EFR32MG13P732F512IM32"

BOARD_UART_FLOW="sw"       # G4 has no RTS/CTS — software XON/XOFF flow (#123)

# --- UART routing: same as Lidl, confirmed on G4 hardware (#130) ---
BOARD_UART_PERIPHERAL="USART0"
BOARD_UART_PERIPHERAL_NO="0"
BOARD_UART_TX="A 0 0"      # PA0 = TX (G4 = Lidl, confirmed #130)
BOARD_UART_RX="A 1 0"      # PA1 = RX (G4 = Lidl, confirmed #130)
BOARD_UART_CTS="A 5 30"    # ignored when flow=sw
BOARD_UART_RTS="A 4 30"    # ignored when flow=sw
