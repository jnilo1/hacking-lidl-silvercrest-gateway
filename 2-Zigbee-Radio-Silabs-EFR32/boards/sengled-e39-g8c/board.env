# board.env — Sengled Smart Hub G4 (E39-G8C), contributed by @hlyi
#
# STATUS: PLACEHOLDER (v3.11.0-pre). Only BOARD_TARGET_DEVICE below is a
# verified fact — the MG13P ordering part number read off the G4 hardware
# page (PR #133). Every BOARD_UART_* value is copied verbatim from the Lidl
# reference and has NOT been confirmed on G4 hardware yet.
#
# Two things must be verified/replaced on real hardware (#130):
#   1. USART instance and TX/RX pin routing to the RTL8196E — the OPN gives
#      the chip, not the pinout this board wired.
#   2. Flow control. The G4 has no RTS/CTS wiring (#123), so it cannot use
#      the hardware handshake below. The host bridge already supports software
#      (XON/XOFF) flow; the matching chip-side build is a follow-up. Until then
#      this placeholder keeps the Lidl hw values so the file parses and builds.
#
# @hlyi: edit the values below to match the G4 and validate the resulting
# NCP / OT-RCP firmware over SWD before it is trusted. See ../README.md.

BOARD_NAME="Sengled Smart Hub G4 (E39-G8C)"

# Exact MCU OPN handed to `slc generate --with` — verified from PR #133.
BOARD_TARGET_DEVICE="EFR32MG13P732F512IM32"

# --- PLACEHOLDER: Lidl values, pending G4 verification (#130) ---
BOARD_UART_PERIPHERAL="USART0"
BOARD_UART_PERIPHERAL_NO="0"
BOARD_UART_TX="A 0 0"      # TODO(hlyi): G4 TX pin
BOARD_UART_RX="A 1 0"      # TODO(hlyi): G4 RX pin
BOARD_UART_FLOW="hw"       # TODO(hlyi): G4 has no RTS/CTS — needs software flow
BOARD_UART_CTS="A 5 30"    # TODO(hlyi): unused once flow != hw
BOARD_UART_RTS="A 4 30"    # TODO(hlyi): unused once flow != hw
