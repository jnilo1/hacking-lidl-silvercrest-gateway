#!/bin/sh
#
# S50uart_bridge — Arm the in-kernel UART<->TCP bridge
#
# Configures baud rate and arms the bridge via sysfs.
# Must run AFTER the 8250 driver has probed ttyS1.  The bridge replaces
# the former userspace serialgateway daemon entirely (removed in v3.0).
#
# The bridge module (built-in) loads at boot with enable=0 and waits
# for this script to arm it — avoids racy auto-arm when /dev/ttyS1
# does not yet exist.
#
# Configuration: /userdata/etc/radio.conf
#   FIRMWARE_BAUD=460800 (default: 460800; the chip-side UART baud, written
#                         by flash_efr32.sh — both ends of the link must agree)
#   BRIDGE_BIND=0.0.0.0  (default: 0.0.0.0 = all interfaces; set to
#                         127.0.0.1 to restrict to loopback and reach
#                         the bridge only via an SSH tunnel — see
#                         drivers/net/rtl8196e-uart-bridge/SECURITY.md)
#   FIRMWARE_FLOW_CTRL=none|sw|hw  (optional; absent => the devicetree
#                         per-board default stands. Selects the flow-control
#                         mode for a radio firmware that differs from the board
#                         default, e.g. an XON/XOFF NCP build. hw is clamped to
#                         sw by the bridge on boards that do not wire RTS/CTS.)
#
# Skipped when radio mode is "otbr" (otbr-agent manages the UART).
#
# J. Nilo - Apr 2026
#

SYSFS="/sys/module/rtl8196e_uart_bridge/parameters"

case "$1" in
start)
    # Skip if the bridge module is not loaded (e.g. running 5.10 kernel)
    if [ ! -d "$SYSFS" ]; then
        exit 0
    fi

    # Skip if radio is configured for OTBR
    if [ -f /userdata/etc/radio.conf ] && grep -q '^MODE=otbr' /userdata/etc/radio.conf; then
        echo "  uart-bridge: skipped (radio mode: otbr)"
        exit 0
    fi

    # Read baud from config, default 460800. FIRMWARE_BAUD is the chip-side
    # truth (set by flash_efr32.sh on every successful flash); a working link
    # forces both ends to the same baud. Fall back to legacy BRIDGE_BAUD for
    # configs migrated from v3.0.x that pre-date the single-key cleanup.
    BAUD=460800
    if [ -f /userdata/etc/radio.conf ]; then
        # Use 'tail -1' so duplicate keys (from manual edits or stale
        # migrations) resolve to the last value rather than the first.
        val=$(grep '^FIRMWARE_BAUD=' /userdata/etc/radio.conf | tail -1 | cut -d= -f2)
        [ -z "$val" ] && val=$(grep '^BRIDGE_BAUD=' /userdata/etc/radio.conf | tail -1 | cut -d= -f2)
        [ -n "$val" ] && BAUD="$val"
    fi

    # Read bind address from config, default 0.0.0.0
    BIND=0.0.0.0
    if [ -f /userdata/etc/radio.conf ]; then
        val=$(grep '^BRIDGE_BIND=' /userdata/etc/radio.conf | tail -1 | cut -d= -f2)
        [ -n "$val" ] && BIND="$val"
    fi

    # Read flow-control firmware mode (optional). none|sw|hw are written
    # verbatim to the bridge's flow_control knob; an invalid value is ignored
    # with a warning. Absent => don't write, leaving flow_control at its
    # devicetree per-board default. The bridge clamps hw to sw on boards that
    # do not wire RTS/CTS, so this can never wedge the UART.
    FW_FC=
    if [ -f /userdata/etc/radio.conf ]; then
        val=$(grep '^FIRMWARE_FLOW_CTRL=' /userdata/etc/radio.conf | tail -1 | cut -d= -f2)
        case "$val" in
            none|sw|hw) FW_FC="$val" ;;
            "")         : ;;
            *) echo "  uart-bridge: WARNING ignoring invalid FIRMWARE_FLOW_CTRL '$val'" >&2 ;;
        esac
    fi

    # Map eth0 led_mode to a STATUS LED brightness for the bridge to fire
    # on TCP client connect. The bridge extinguishes the LED on disconnect.
    # Users who want a different intensity can override status_led_brightness
    # later; this just wires up a sensible default.
    case "$(cat /sys/class/net/eth0/led_mode 2>/dev/null)" in
        bright) STATUS_BRIGHT=255 ;;
        dim)    STATUS_BRIGHT=60  ;;
        off)    STATUS_BRIGHT=0   ;;
        *)      STATUS_BRIGHT=255 ;;
    esac
    echo "$STATUS_BRIGHT" > "$SYSFS/status_led_brightness" 2>/dev/null || true

    # Bind the kernel trigger to the STATUS LED if not already bound.
    # (Idempotent: writing the same trigger name again is a no-op.)
    if [ -w /sys/class/leds/status/trigger ]; then
        echo uart-bridge-client > /sys/class/leds/status/trigger 2>/dev/null || true
    fi

    echo "$BAUD" > "$SYSFS/baud"
    echo "$BIND" > "$SYSFS/bind_addr"
    [ -n "$FW_FC" ] && echo "$FW_FC" > "$SYSFS/flow_control"
    echo 1 > "$SYSFS/enable"

    # The kernel driver logs "armed on <tty> @ <baud> baud, listening on ..."
    # on success — no need to echo from here. Only complain on failure.
    if [ "$(cat "$SYSFS/armed")" != "1" ]; then
        echo "  uart-bridge: ERROR failed to arm" >&2
        exit 1
    fi
    ;;

stop)
    if [ ! -d "$SYSFS" ]; then
        exit 0
    fi

    echo 0 > "$SYSFS/enable"
    ;;

restart)
    $0 stop
    sleep 1
    $0 start
    ;;

*)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0
