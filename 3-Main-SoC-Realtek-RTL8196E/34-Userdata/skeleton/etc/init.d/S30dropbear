#!/bin/sh
#
# S30dropbear - Dropbear SSH server startup script (user-editable)
#
# This script starts or stops the Dropbear SSH server.
# You can customize the DROPBEAR_OPTS variable below.
#
# Common Dropbear options:
#   -p [port]   : Listen on specified port (default: 22)
#   -w          : Disallow root logins
#   -s          : Disable password logins (only pubkey allowed)
#   -g          : Allow root logins without password (pubkey only)
#   -F          : Run in foreground (useful for debugging)
#   -K [seconds]: Disconnect if no traffic is transmitted during K seconds
#
# For all options: https://manned.org/dropbear.8
#
# J. Nilo - May 2025
#
DROPBEAR_OPTS="-p 22 -K 300"
KEYDIR="/etc/dropbear"
PIDFILE="/var/run/dropbear.pid"

# Generate server keys only once, on the first boot.
#
# No RSA host key. Measured on this SoC: ed25519 takes 0.2 s, ecdsa 0.3 s, and
# RSA-2048 takes 32 s — sixty-five times the other two together. This function
# runs synchronously in the boot sequence, so that cost used to delay every
# service after it while the network was already up: the gateway answered ping
# but refused SSH for half a minute, which reads as a hang.
#
# Dropbear is started without -r and without -R, so it serves exactly the host
# keys that exist here and offers no other algorithm. ed25519 has been accepted
# by OpenSSH since 6.5 and PuTTY since 0.68, ecdsa by OpenSSH since 5.7, so any
# client of the last decade connects. This is the HOST key only — logging in
# with an RSA *user* key is unaffected.
#
# Gateways installed before this change keep the RSA key they already have:
# nothing here deletes keys, and etc/dropbear is preserved across upgrades, so
# no one gets a host-key-changed warning. Anyone who needs RSA for an old client
# can create it once:
#
#   dropbearkey -t rsa -f /userdata/etc/dropbear/dropbear_rsa_host_key && reboot
generate_keys() {
    echo "  dropbear: checking host keys"

    mkdir -p "$KEYDIR"
    chmod 700 "$KEYDIR"

    [ -f "$KEYDIR/dropbear_ecdsa_host_key" ] || {
        echo "  dropbear: generating ECDSA host key"
        dropbearkey -t ecdsa -f "$KEYDIR/dropbear_ecdsa_host_key"
    }

    [ -f "$KEYDIR/dropbear_ed25519_host_key" ] || {
        echo "  dropbear: generating ED25519 host key"
        dropbearkey -t ed25519 -f "$KEYDIR/dropbear_ed25519_host_key"
    }
}
# Fix permissions required by dropbear for pubkey authentication
# Note: /root is 750 in rootfs (squashfs, read-only) — no chmod needed
fix_permissions() {
    chmod 700 /userdata/ssh 2>/dev/null || true
    chmod 600 /userdata/ssh/authorized_keys 2>/dev/null || true
}

case "$1" in
start)
    fix_permissions
    generate_keys
    echo "  dropbear: sshd started ($DROPBEAR_OPTS)"
    dropbear $DROPBEAR_OPTS
    ;;
stop)
    echo "  dropbear: stopped"
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" && rm -f "$PIDFILE"
    else
        killall dropbear 2>/dev/null
    fi
    ;;
restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
*)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
