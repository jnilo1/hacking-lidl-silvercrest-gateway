#!/bin/sh
# S70otbr — Start OpenThread Border Router agent
#
# Requires:
#   - Kernel with IPv6 + CONFIG_FILE_LOCKING
#   - EFR32 flashed with OT-RCP firmware
#   - otbr-agent binary in /userdata/usr/bin/
#
# Storage:
#   otbr-agent runs from tmpfs (/tmp/thread) to protect JFFS2 from flash
#   wear (frame counters update ~480 times/day). A background daemon polls
#   the active dataset every 30s and syncs to flash (/userdata/thread) only
#   when the dataset changes. On clean shutdown (SIGTERM), a final sync runs.
#   On power loss, only frame counters are lost — OpenThread recovers by
#   jumping ahead on next boot.

OTBR_BIN="/userdata/usr/bin/otbr-agent"

# UART settings — must match EFR32 OT-RCP firmware.
# Baud is read from /userdata/etc/radio.conf (FIRMWARE_BAUD= key, the chip-side
# truth written by flash_efr32.sh on every successful flash) so the OT-RCP
# firmware-baud and the host-side spinel client always agree. Fall back to
# legacy OTBR_BAUD for configs migrated from v3.0.x that pre-date the
# single-key cleanup.
# Default to 460800 (the historical OT-RCP build baud) if the key is absent.
FW_BAUD=460800
if [ -f /userdata/etc/radio.conf ]; then
    # Use 'tail -1' so duplicate keys (from manual edits or stale migrations)
    # resolve to the last value rather than the first.
    val=$(grep '^FIRMWARE_BAUD=' /userdata/etc/radio.conf | tail -1 | cut -d= -f2)
    [ -z "$val" ] && val=$(grep '^OTBR_BAUD=' /userdata/etc/radio.conf | tail -1 | cut -d= -f2)
    case "$val" in
        115200|230400|460800|691200|892857) FW_BAUD="$val" ;;
    esac
fi
# uart-flow-control tells otbr-agent to set CRTSCTS on the tty, which the 8250
# core then propagates as MCR_AFE on the 16550A. On the Lidl board (RTS/CTS
# wired) it is REQUIRED: without it the RX FIFO can overrun under bursty Spinel
# traffic at 460800 (#89).
#
# OpenThread treats uart-flow-control as a PRESENCE flag: Url::HasParam() only
# checks that the name occurs in the query string, so "uart-flow-control=false"
# still enables CRTSCTS (#142, root-caused by @hlyi). To disable flow control
# the parameter must be OMITTED from the URL entirely.
#
# Derived from FIRMWARE_FLOW_CTRL in radio.conf: hw (or absent) => parameter
# present; none|sw => parameter omitted, for a board/firmware without hardware
# flow control (e.g. the G4, which does not wire RTS/CTS). otbr-agent speaks
# spinel straight to /dev/ttyS1 (the bridge is not in the path), so only
# hardware flow control is meaningful here — sw selects "no CRTSCTS" too.
FC_PARAM="&uart-flow-control=true"
if [ -f /userdata/etc/radio.conf ]; then
    val=$(grep '^FIRMWARE_FLOW_CTRL=' /userdata/etc/radio.conf | tail -1 | cut -d= -f2)
    case "$val" in
        none|sw) FC_PARAM="" ;;
    esac
fi
RCP_URL="spinel+hdlc+uart:///dev/ttyS1?uart-baudrate=${FW_BAUD}${FC_PARAM}"

# Network interfaces
THREAD_IF="wpan0"
BACKBONE_IF="eth0"

# REST API — listen on all interfaces so HA can reach it
REST_LISTEN="::0"
REST_PORT="8081"

# Storage paths
FLASH_DIR="/userdata/thread"
RAM_DIR="/tmp/thread"

# Supervision (issue #109): otbr-agent and the housekeeping monitor are each
# run under `keepalive` via the shared sup_start/sup_stop helpers, so OTBR
# self-heals from an agent crash / RCP fault. otbr-monitor is now a C daemon
# (no longer a busybox-ash loop), so no long-lived ash process remains. sup_stop
# kills the supervisor before the child (killing a child alone would only
# trigger a restart).
. "$(dirname "$0")/supervise.func"
OTBR_MONITOR="/usr/sbin/otbr-monitor"
SRP_DONE_FLAG="/tmp/otbr-srp-recovery.done"

case "$1" in
start)
    [ -x "$OTBR_BIN" ] || exit 0

    # Only start if radio mode is set to "otbr" in /userdata/etc/radio.conf
    if ! [ -f /userdata/etc/radio.conf ] || ! grep -q '^MODE=otbr' /userdata/etc/radio.conf; then
        exit 0
    fi

    # Idempotent: refuse to stack a second supervised instance on top of one
    # already running. Without this, a double start would re-run the dataset
    # restore below and could orphan a live supervisor pair. (sup_start also
    # guards per-service, but this bails out the whole bring-up early.)
    if [ -n "$(sup_pids otbr-agent)$(sup_pids otbr-monitor)" ]; then
        echo "  otbr: already running, skipping start"
        exit 0
    fi

    # Restore settings from flash to tmpfs
    mkdir -p "$FLASH_DIR" "$RAM_DIR"
    cp "$FLASH_DIR"/* "$RAM_DIR"/ 2>/dev/null

    # Enable IPv6 forwarding (required for border routing)
    echo 1 > /proc/sys/net/ipv6/conf/all/forwarding
    # Accept Router Advertisements even with forwarding enabled (default drops
    # to 0 when forwarding=1), so the gateway can acquire a GUA via SLAAC
    echo 2 > /proc/sys/net/ipv6/conf/eth0/accept_ra

    # Clear the once-per-boot SRP recovery flag (tmpfs may survive a `restart`).
    rm -f "$SRP_DONE_FLAG"

    # Supervise otbr-agent under keepalive: restart on crash / RCP fault.
    # Post-start tuning (log level, TX power) is owned by otbr-monitor so it
    # re-applies on every restart, not just the first launch.
    sup_start otbr-agent \
        "$OTBR_BIN" \
        -d 4 \
        -I "$THREAD_IF" \
        -B "$BACKBONE_IF" \
        --rest-listen-address "$REST_LISTEN" \
        --rest-listen-port "$REST_PORT" \
        --vendor-name "Lidl" \
        --model-name "Silvercrest" \
        --data-path "$RAM_DIR" \
        "$RCP_URL"

    # Supervise the housekeeping monitor (radio tuning, status LED, dataset
    # sync, one-shot SRP recovery). Its keepalive restart re-applies the radio
    # tuning, so a monitor restart is transparent.
    sup_start otbr-monitor "$OTBR_MONITOR"
    echo "  otbr: border router started (otbr-agent + monitor)"
    ;;

stop)
    # Stop each supervisor (and its child) via the shared helper: it kills the
    # keepalive supervisor first, then re-signals any survivor matched by
    # command line until dead (SIGKILL last resort) — killing a child alone
    # would only trigger a restart. otbr-agent and otbr-monitor are stopped
    # independently, each by its own command-line token.
    sup_stop otbr-agent
    sup_stop otbr-monitor

    # Reset LED (also done by otbr-monitor on SIGTERM)
    echo 0 > /sys/class/leds/status/brightness
    echo "  otbr: stopped"
    ;;

restart)
    $0 stop
    sleep 1
    $0 start
    ;;

*)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0
