#!/bin/sh
#
# S26panicrec — persist the FIRST kernel panic post-mortem to /userdata
#
# When the gateway auto-recovers from a soft-lockup hang, the watchdog
# driver (rtl819x_wdt) leaves a one-shot record in a reserved DRAM page and
# prints one compact record-v9 line on the next boot:
#
#   rtl819x-wdt ...: previous panic: uptime=..s epc=... ra=...
#                         cause=... status=... softirq=... wdt=...
#                         flags=... reason=".."
#
# This line lives only in the volatile ramfs kernel log and is lost on the
# next reboot. This script persists it into /userdata for later inspection.
#
# Capture policy: FIRST OCCURRENCE ONLY. Once $LOG exists, every later panic
# is ignored — we keep the first, cleanest capture and never let a reboot
# loop overwrite it or grow the file. To re-arm (e.g. after a fix, to catch
# a fresh occurrence) delete the file by hand:
#
#   rm /userdata/panic/history
#
# Flash wear: this writes to the JFFS2 partition at most ONCE per re-arm
# (one short line, only the first time after an rm). A panic is already a rare
# event, and the first-occurrence guard means even a reboot loop costs zero
# further writes — so there is no NOR-flash wear concern whatsoever.
#
# Runs after S20time and S25watchdog — but do NOT read that as "the wall
# clock is set by now". This board has no RTC, so the clock starts at the
# epoch on every boot, and since #125 S20time merely *starts* ntpd as a
# daemon instead of blocking on a one-shot sync: the step lands seconds to
# minutes later, always after this script. The capture line therefore says
# so explicitly rather than stamping a confident 1970 date on the one
# artifact an operator reads weeks later. The record's own uptime= field is
# the trustworthy indication of when the panic happened.

LOG=/userdata/panic/history

case "$1" in
	start|"")
		# Already captured one — block until manually cleared. Say so: a
		# saved record is worth knowing about at boot, and silence here
		# reads the same as "nothing happened".
		if [ -f "$LOG" ]; then
			echo "  panicrec: skipped (record already saved, delete to re-arm)"
			exit 0
		fi

		record=$(dmesg | grep -E 'rtl819x-wdt.*previous panic:')
		if [ -z "$record" ]; then
			echo "  panicrec: skipped (no panic record)"
			exit 0
		fi

		# Flag an unsynced clock instead of dating the capture 1970.
		stamp=$(date '+%Y-%m-%d %H:%M:%S')
		if [ "$(date '+%Y')" -lt 2020 ]; then
			stamp="$stamp (clock not yet synced, see uptime= below)"
		fi

		mkdir -p /userdata/panic
		{
			echo "$stamp --- panic record capture ---"
			echo "$record"
		} > "$LOG"
		echo "  panicrec: captured to $LOG (delete to re-arm)"
		;;
	stop)
		;;
	*)
		echo "Usage: $0 {start|stop}"
		;;
esac
exit 0
