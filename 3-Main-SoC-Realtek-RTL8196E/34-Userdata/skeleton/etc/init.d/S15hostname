#!/bin/sh
#
# S15hostname — Set system hostname and update /etc/hosts
# -----------------------------------------------------------------------------
# This script:
#   1. Reads the hostname from /etc/hostname and sets it via the BusyBox `hostname` applet.
#   2. Reads the current IP from /var/run/current_eth0_ip (written by DHCP client or static config).
#   3. Updates /etc/hosts with localhost, and the current IP mapped to the hostname.
#   4. If the IP is the DHCP-failure fallback from /userdata/etc/eth0.bak,
#      notes this in the logs but continues.
#
# Dependencies:
#   - /etc/hostname must exist and contain a valid hostname.
#   - /var/run/current_eth0_ip must contain the IP address (normal or fallback).
#
# J. Nilo - Nov 2025
#
[ "$INIT_VERBOSE" = "0" ] && exec >/dev/null

case "$1" in
start)
    # Set system hostname
    HOSTNAME=$(cat /etc/hostname)
    hostname -F /etc/hostname

    # Read IP assigned to eth0
    CURRENT_IP=$(cat /var/run/current_eth0_ip 2>/dev/null || echo "")

    # Check if IP is valid
    if [ -z "$CURRENT_IP" ]; then
        echo "  hostname: WARNING eth0 has no IP address configured"
        # Use loopback as fallback (Debian convention for dynamic hosts)
        CURRENT_IP="127.0.1.1"
    elif [ -f /userdata/etc/eth0.bak ] \
         && grep -q "^IPADDR=${CURRENT_IP}\$" /userdata/etc/eth0.bak; then
        # udhcpc.script applied the eth0.bak fallback — no lease was obtained.
        # The address is no longer a fixed 192.168.1.254, so recognise it by
        # matching the file rather than by hardcoding a value here.
        echo "  hostname: using DHCP-failure fallback IP $CURRENT_IP"
    else
        echo "  hostname: $HOSTNAME ($CURRENT_IP)"
    fi

    # Write /var/hosts (symlinked from /etc/hosts to avoid jffs2 writes)
    cat >/var/hosts <<EOF
127.0.0.1         localhost
$CURRENT_IP       $HOSTNAME
EOF

    # resolv.conf is set by S10network (static: from eth0.conf, DHCP: from udhcpc)

    # Clean-up
    if [ -f /var/run/current_eth0_ip ]; then
        rm /var/run/current_eth0_ip
    fi
    ;;

stop)
    # Nothing to clean up
    ;;

*)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac

exit 0
